{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Qentra browser request record v1",
  "type": "object",
  "description": "Structural browser record schema. validateRecord checks digests, source status, output length and mapping reproduction. Cross-field arithmetic constraints require the runtime validator.",
  "required": [
    "schemaVersion",
    "id",
    "createdAt",
    "updatedAt",
    "adapterId",
    "sourceMode",
    "input",
    "inputDigest",
    "state",
    "verification",
    "delivery",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-]{1,100}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "adapterId": {
      "const": "qentra-browser-v1"
    },
    "sourceMode": {
      "const": "browser-cryptographic"
    },
    "input": {
      "type": "object",
      "required": [
        "bytes"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        }
      }
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outputBytes": {
      "type": "string",
      "pattern": "^([a-fA-F0-9]{2})+$"
    },
    "state": {
      "enum": [
        "created",
        "generating",
        "produced",
        "failed"
      ]
    },
    "error": {
      "type": "string"
    },
    "verification": {
      "const": "not-applicable"
    },
    "delivery": {
      "const": "not-requested"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "at",
          "state"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string"
          }
        }
      }
    },
    "mapping": {
      "type": "object",
      "required": [
        "version",
        "config",
        "result"
      ],
      "properties": {
        "version": {
          "const": "qentra-sha256-v1"
        },
        "config": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "kind",
                "min",
                "max"
              ],
              "properties": {
                "kind": {
                  "const": "uniformInt"
                },
                "min": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                "max": {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "items"
              ],
              "properties": {
                "kind": {
                  "const": "shuffle"
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "items",
                "weights"
              ],
              "properties": {
                "kind": {
                  "const": "weightedPick"
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "weights": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967296
                  }
                }
              }
            },
            {
              "type": "object",
              "required": [
                "kind",
                "items",
                "count"
              ],
              "properties": {
                "kind": {
                  "const": "pickUnique"
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1000,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                }
              }
            }
          ]
        },
        "result": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "produced"
          }
        }
      },
      "then": {
        "required": [
          "outputBytes"
        ]
      }
    }
  ]
}
